#!/bin/bash

#   Copyright (C) 2019 University of Oxford
#
#   SHCOPYRIGHT

# Written by Ying-Qiu Zheng

Usage() {
    echo ""
    echo "Usage:"
    echo ""
    echo "create_tracts -bpx <bedpostX_dir> -out <output_dir> -masks <masks_dir> -str <str_name>"
    echo "create_tracts -bpx <bedpostX_dir> -out <output_dir> -masks <masks_dir> -str <str_name> -warp <ref2diff> <diff2ref> -ref <refimage> -gpu"
    echo "create_tracts -help"
    echo ""
    echo ""
    echo "Example: "
    echo ""
    echo "create_tracts -masks subj001/masks -bpx subj001/dMRI.bedpostX -seed thalamus.nii.gz -out subj001"
    echo ""
    echo ""
    echo "creates tracts for the specified seed, using fiber samples estimated via BedpostX"
    echo ""
    echo ""
    echo "Compulsory arguments:"
    echo ""
    echo "-bpx <folder>                                       Path to bedpostx folder"
    echo "-masks <folder>                                     Path to mask folder"
    echo "-str <structure_name>                               Structure to be localised, e.g., vim, lgn, etc."
    echo "-out <folder>                                       Path to output folder."
    echo ""
    echo ""
    echo "Optional arguments:"
    echo ""
    echo "-warp <ref2diff> <diff2ref>                         (Optional) Transformation matrix/field between the reference space (i.e., the space of the anatomical masks) and the diffusion space."
    echo "                                                               Necessary if the reference space is not the diffusion space."
    echo "-ref <path>                                         (Optional) Path to reference image, usually in the individual T1 native space."
    echo "                                                               Necessary if the reference space is not the diffusion space."
    echo "-ptx_opts <options.txt>	                            (Optional) Pass extra probtrackx2 options as a text file to override defaults, e.g. --steplength=0.2 --distthresh=10"
    echo "-gpu                                                (Optional) Use the GPU version of probtractx2."
    echo ""
    exit 1
}

Usage() {
    cat << EOF

Usage:
    create_tracts -bpx <bedpostX_dir> -out <output_dir> -masks <masks_dir> -str <str_name>
    create_tracts -bpx <bedpostX_dir> -out <output_dir> -masks <masks_dir> -str <str_name> -warp <ref2diff> <diff2ref> -ref <refimage> -gpu
    create_tracts -help

Example:
    create_tracts -masks subj001/masks -bpx subj001/dMRI.bedpostX -seed thalamus.nii.gz -out subj001

Creates tracts for the specified seed, using fiber samples estimated via BedpostX

Compulsory arguments:
    -bpx <folder>                   Path to bedpostx folder
    -masks <folder>                 Path to mask folder
    -str <structure_name>           Structure to be localised, e.g., vim, lgn, etc.
    -out <folder>                   Path to output folder

Optional arguments:
    -warp <ref2diff> <diff2ref>     (Optional) Transformation matrix/field between the reference space (i.e., the space of the anatomical masks) and the diffusion space.
                                    Necessary if the reference space is not the diffusion space.
    -ref <path>                     (Optional) Path to reference image, usually in the individual T1 native space.
                                    Necessary if the reference space is not the diffusion space.
    -ptx_opts <options.txt>         (Optional) Pass extra probtrackx2 options as a text file to override defaults, e.g. --steplength=0.2 --distthresh=10
    -gpu                            (Optional) Use the GPU version of probtractx2.

EOF
    exit 1
}

[ -z "$1" ] && Usage

if [ -z "$FSLDIR" ]; then
  echo "Environment variable $FSLDIR does not exist. Please set up FSLDIR. "
  exit 1
fi

get_abs_file_path() {
    file_path=$1

    # Check if realpath is available
    if command -v realpath > /dev/null 2>&1; then
        abs_path=$(realpath "$file_path")
    # Fallback to readlink -f if realpath is not available
    elif command -v readlink > /dev/null 2>&1; then
        abs_path=$(readlink -f "$file_path")
    else
        echo "Error: realpath and readlink commands are not available."
        return 1
    fi

    echo "$abs_path"
}

### some default values
prog="probtrackx2"
ptx_opts=""

### parse arguments
while [ -n "$1" ]; do
  case "$1" in
    -help)
    Usage
    ;;
    -gpu)
    prog="probtrackx2_gpu"
    ;;
    -ref)
    ref="$2"
    shift
    ;;
    -bpx)
    bpx="$2"
    shift
    ;;
    -out)
    out="$2"
    shift
    ;;
    -masks)
    inputdir="$2"
    shift
    ;;
    -str)
    str="$2"
    shift
    ;;
    -warp)
    ref2diff="$2"
    diff2ref="$3"
    shift 2;
    ;;
    -ptx_opts)
    ptx_opts=$(cat "$2")
    shift
    ;;
    *)
    echo "Unknown option: $1" >&2
    exit 1
    ;;
  esac
  shift
done

# Check for required arguments

for file in inputdir bpx str out; do
  if [ -z "${!file}" ]; then
    echo "Error: Missing required argument -$file. Please specify the $file." >&2
    exit 1
  fi
done

for file in inputdir bpx; do
  if [ ! -d "${!file}" ]; then
    echo "${!file} does not exist. Please double check the path." >&2
    exit 1
  fi
done

refpath=$(get_abs_file_path "$inputdir")

# create output dir
mkdir -p "$out/$str/tracts/left" "$out/$str/tracts/right" "$out/$str/logs"

case "$str" in
  vim)
  seed="tha.nii.gz"
  ;;
  lgn)
  seed="lgn_bin.nii.gz"
  ;;
  *)
  echo "Error: Unknown structure $str. Please specify a valid structure." >&2
  exit 1
  ;;
esac

if [ -z "$brainmask" ]; then
  brainmask="$bpx/nodif_brain_mask"
  if [ ! -f "$brainmask.nii.gz" ] && [ ! -f "$brainmask.nii" ]; then
    echo "$brainmask.nii.gz or $brainmask.nii does not exist under $bpx. Creating one..."
    fslmaths "$bpx/mean_fsumsamples" -thr 0 -bin "$brainmask"
  fi
fi

echo "## Create commands for tractography" > "$out/$str/create_tracts_cmds";
echo " " >> "$out/$str/create_tracts_cmds";

# for left and right hemispheres
for hemi in left right; do
  ## create a list containing the anatomical masks
  echo "$inputdir/$hemi/ar_mask{1..8}.nii.gz" > "$out/$str/tracts/$hemi/targets.txt"
  echo "$inputdir/$hemi/or_mask{1..10}.nii.gz" >> "$out/$str/tracts/$hemi/targets.txt"
  echo "$inputdir/$hemi/str_mask{1..10}.nii.gz" >> "$out/$str/tracts/$hemi/targets.txt"
  echo "$inputdir/$hemi/atr_mask{1..8}.nii.gz" >> "$out/$str/tracts/$hemi/targets.txt"
  echo "$inputdir/$hemi/fx_mask{1..10}.nii.gz" >> "$out/$str/tracts/$hemi/targets.txt"
  echo "$inputdir/$hemi/to_precentral_mask{1..12}.nii.gz"  >> "$out/$str/tracts/$hemi/targets.txt"
  echo "$inputdir/$hemi/to_postcentral_mask{1..12}.nii.gz"  >> "$out/$str/tracts/$hemi/targets.txt"
  echo "$inputdir/$hemi/{1..75}.nii.gz" >> "$out/$str/tracts/$hemi/targets.txt"
  # create a list containing termination masks
  echo "$inputdir/cortex.nii.gz" > "$out/$str/tracts/$hemi/stops.txt"
  echo "$inputdir/csf.nii.gz" >> "$out/$str/tracts/$hemi/stops.txt"

  opts="-x $inputdir/$hemi/$seed -s $bpx/merged -m $brainmask --dir=$out/$str/tracts/$hemi --forcedir $ptx_opts"

  if [ -n "$ref2diff" ]; then
    opts="$opts --xfm=$ref2diff --invxfm=$diff2ref"
    if [ -n "$ref" ]; then
      opts="$opts --seedref=$ref"
    else
      opts="$opts --seedref=$inputdir/$hemi/$seed"
    fi
  fi

  cmd="$FSLDIR/bin/$prog $opts"
  cmd="$cmd --targetmasks=$out/$str/tracts/$hemi/targets.txt"
  cmd="$cmd --avoid=$inputdir/$hemi/exclusion --stop=$out/$str/tracts/$hemi/stops.txt"

  ### run tractography...
  echo $cmd >> "$out/$str/create_tracts_cmds"
  #eval $cmd;
  if [[ "$str" == "vim" ]]; then  
    ## extra features for VIM
    echo $inputdir/$hemi/scpct_mask{1..15}.nii.gz > $out/$str/tracts/$hemi/scpct_targets.txt
    echo $inputdir/$hemi/cerebellum_target.nii.gz >> $out/$str/tracts/$hemi/scpct_targets.txt
    cmd="$FSLDIR/bin/$prog $opts"
    cmd="$cmd --targetmasks=$out/$str/tracts/$hemi/scpct_targets.txt"
    cmd="$cmd --avoid=$inputdir/$hemi/exclusion --stop=$inputdir/$hemi/stop_for_scpct"
    echo "$cmd" >> "$out/$str/create_tracts_cmds"
  elif [[ "$str" == "lgn" ]]; then
    echo "#TODO: implement additional tractography protocols for LGN"
  fi
  #eval $cmd;
done

queue_status=`fsl_sub --has_queues`
if [[ "$queue_status" == "Yes" ]]; then
  if $gpu; then
    fsl_sub -T 300 -R 30 -n --coprocessor=cuda  -N "create_tracts_for_${str}" -l "$out/$str/logs" -t "$out/$str/create_tracts_cmds"
  else
    fsl_sub -T 2160 -R 30 -n -N "create_tracts_for_${str}" -l "$out/$str/logs" -t "$out/$str/create_tracts_cmds"
  fi
else
  bash "$out/$str/create_tracts_cmds"
fi
