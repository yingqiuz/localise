#!/bin/bash

#   Copyright (C) 2019 University of Oxford
#
#   SHCOPYRIGHT

# Written by Ying-Qiu Zheng

Usage() {
    echo ""
    echo "Usage: create_masks [-ref <path>] [-warp <path>] [-out <folder>] [-aparc <path>] [-str <str_name>]"
    echo ""
    echo "Example usage: create_masks -ref subj001/t1.nii.gz -out subj001 -aparc subj001/aparc.a2009s+aseg.nii.gz -warp subj001/std2str_warp.nii.gz -str vim"
    echo ""
    echo "Description:"
    echo "  Creates anatomical masks in reference space (-ref) for tractography and stores them under the output folder."
    echo ""
    echo "Options:"
    echo "  -ref <path>                   Path to reference image, typically in T1 native space or diffusion space."
    echo "  -warp <path>                  Path to warp field mapping the MNI standard space to the reference space."
    echo "  -aparc <path>                 Path to cortical segmentation file generated by Freesurfer. Must be inthe reference space."
    echo "  -out <folder>                 Path to output folder."
    echo "  -str <strcture_name>          Name of structure, e.g., vim, lgn, etc."
    echo "  -brainmask <path>             (Optional) Path to binary brain mask in the reference space."
    echo ""
    exit 1
}

[ -z "$1" ] && Usage

if [ -z "$FSLDIR" ]; then
  echo "Environment variable $FSLDIR does not exist. Please set up FSLDIR. "
  exit 1
fi

## path of the script  ### TODO: have a safer way to fetch the resources path
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
RESOURCES_DIR="$(dirname $SCRIPT_DIR)/resources"

### make file path absolute
get_abs_file_path() {
    file_path=$1

    # Check if realpath is available
    if command -v realpath > /dev/null 2>&1; then
        abs_path=$(realpath "$file_path")
    # Fallback to readlink -f if realpath is not available
    elif command -v readlink > /dev/null 2>&1; then
        abs_path=$(readlink -f "$file_path")
    else
        echo "Error: realpath and readlink commands are not available."
        return 1
    fi

    echo "$abs_path"
}

# set default options
ref=""
warp=""
aparc=""
out=""
brainmask=""
str=""

### parse arguments
while [ -n "$1" ]; do
  case "$1" in
    -help)
      Usage
      ;;
    -ref)
      ref="$2"
      shift
      ;;
    -out)
      out="$2"
      shift
      ;;
    -warp)
      warp="$2"
      shift
      ;;
    -aparc)
      aparc="$2"
      shift
      ;;
    -brainmask)
      brainmask="$2"
      shift
      ;;
    -str)
      str="$2"
      shift
      ;;
    *)
      echo "Error: Invalid argument: $1"
      exit 1
    ;;
  esac
  shift
done

### Check if required arguments are provided
if [ -z "$ref" ]; then
  echo "Error: Missing required argument -ref. Please specify the reference image."
  Usage
  exit 1
elif [ ! -f $ref ]; then
  echo "Error: $ref not exist. "
  exit 1
else
  refpath=$(get_abs_file_path "$ref")
fi

if [ -z "$warp" ]; then
  echo "Error: Missing required argument -warp. Please specify the warp field mapping the MNI standard space to reference space."
  exit 1
elif [ ! -f $warp ]; then
  echo "Error: $warp not exist. "
  exit 1
fi

if [ -z "$aparc" ]; then
  echo "Error: Missing required argument -aparc. Please specify the cortical parcellation file (generated by recon-all)."
  exit 1
elif [ ! -f $aparc ]; then
  echo "Error: $aparc not exist. "
  exit 1
fi

if [ -z "$out" ]; then
  echo "Error: Missing required argument -out. Please specify the output directory."
  exit 1
fi

if [ -z "$str" ]; then
  echo "Error: Missing required argument -str. Please specify the structure to be localised."
  exit 1
fi

### create output directory
if [ ! -d $out/masks ]; then
  mkdir -p $out/masks
fi
### create dir for left and right hemisphere
for hemi in left right; do
  if [ ! -d $out/masks/$hemi ]; then
    mkdir $out/masks/$hemi
  fi
done

if [ ! -z "$aparc" ]; then
  aparc_basename=$(basename "$aparc")
  if [[ "$aparc" == *.mgz ]]; then  # TODO: maybe remove this
    if [ -z "$FREESURFER_HOME" ]; then
      echo "If you feed in the aparc.a2009s+aseg in *.mgz format, please set up FREESURFER_HOME. "
      exit 1
    fi
    $FREESURFER_HOME/bin/mri_convert $aparc $out/masks/${aparc_basename%.*}.nii.gz
    $FSLDIR/bin/flirt -in $out/masks/${aparc_basename%.*}.nii.gz -ref $ref -out $out/masks/${aparc_basename%.*}.nii.gz -applyxfm -usesqform -interp nearestneighbour
    aparc="$out/masks/${aparc_basename%.*}.nii.gz"
  elif [[ "$aparc" == *.nii ]] || [[ "$aparc" == *.nii.gz ]]; then
    $FSLDIR/bin/flirt -in $aparc -ref $ref -out $out/masks/${aparc_basename} -applyxfm -usesqform -interp nearestneighbour 
    aparc="$out/masks/${aparc_basename}"
  else
    echo "Invalid aparc.a2009s+aseg file. Please use *.mgz or *.nii.gz/*.nii file."
    exit 1
  fi
  #### cerebellum
  echo "$FSLDIR/bin/fslmaths $aparc -thr 6 -uthr 8 -bin $out/masks/left/cerebellum" > $out/create_masks_cmds
  echo "$FSLDIR/bin/fslmaths $aparc -thr 45 -uthr 47 -bin $out/masks/right/cerebellum" >> $out/create_masks_cmds
  echo "$FSLDIR/bin/fslmaths $aparc -thr 7 -uthr 7 -bin $out/masks/right/cerebellum_target" >> $out/create_masks_cmds
  echo "$FSLDIR/bin/fslmaths $aparc -thr 46 -uthr 46 -bin $out/masks/left/cerebellum_target" >> $out/create_masks_cmds
  echo "$FSLDIR/bin/fslmaths $aparc -thr 24 -uthr 24 -bin $out/masks/csf" >> $out/create_masks_cmds

  ### left hemisphere cortical masks
  for k in {11101..11175}; do
    kk=`expr $k - 11100`
    echo "$FSLDIR/bin/fslmaths $aparc -thr $k -uthr $k -bin $out/masks/left/$kk" >> $out/create_masks_cmds
  done
  #echo "$FSLDIR/bin/fslmaths $aparc -thr 11100 -uthr 12175 -bin $out/cortex" >> $out/create_masks_cmds
  ### right hemisphere cortical masks
  for k in {12101..12175}; do
    kk=`expr $k - 12100`
    echo "$FSLDIR/bin/fslmaths $aparc -thr $k -uthr $k -bin $out/masks/right/$kk" >> $out/create_masks_cmds
  done
  echo "$FSLDIR/bin/fslmaths $aparc -thr 11100 -uthr 12175 -bin $out/masks/cortex" >> $out/create_masks_cmds
fi

#$FSLDIR/bin/fslmaths $out/right/cortex -add $out/left/cortex -bin $out/cortex

for hemi in left right; do
  ### create white matter masks - SCPCT tract
  for tract in scpct_mask{1..15}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> $out/create_masks_cmds
  done
  ### STR
  for tract in str_mask{1..10}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> $out/create_masks_cmds
  done
  ### ATR
  for tract in atr_mask{1..8}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> $out/create_masks_cmds
  done
  ### AR
  for tract in ar_mask{1..8}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> $out/create_masks_cmds
  done
  ### OR
  for tract in or_mask{1..10}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> $out/create_masks_cmds
  done
  ### fornix
  for tract in fx_mask{1..10}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> $out/create_masks_cmds
  done
  ### M1
  for tract in to_precentral_mask{1..12}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> $out/create_masks_cmds
  done
  ### S1
  for tract in to_postcentral_mask{1..12}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> $out/create_masks_cmds
  done

  case "$str" in
    vim)
      ### thalamus - although it's recommend to use FSL's MIST
      echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/tha -w $warp -o $out/masks/$hemi/tha --interp=nn" >> $out/create_masks_cmds
      echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/vim -w $warp -o $out/masks/$hemi/vim" >> $out/create_masks_cmds
      ;;
    lgn)
      echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/lgn -w $warp -o $out/masks/$hemi/lgn" >> $out/create_masks_cmds
      echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/lgn_bin -w $warp -o $out/masks/$hemi/lgn_bin  --interp=nn" >> $out/create_masks_cmds
      ;;
    *)
      echo "$str currently not supported. "
      exit 1
      ;;
  esac

  echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/exclusion -w $warp -o $out/masks/$hemi/exclusion --interp=nn" >> $out/create_masks_cmds

  if [ -z "$aparc" ]; then   ### To be removed? maybe not?
    ### cerebellum - although it's recommend to use freesurfer's segmentation
    ##### MNI_roi/$hemi/cerebellum_target is the contralateral cerebellar target
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/cerebellum_target -w $warp -o $out/masks/$hemi/cerebellum_target --interp=nn" >> $out/create_masks_cmds
    ##### MNI_roi/$hemi/cerebellum is ipsilateral cerebellum to avoid
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/cerebellum -w $warp -o $out/masks/$hemi/cerebellum --interp=nn" >> $out/create_masks_cmds
    ### cortical parcels - if no aparc.a2009s+aseg file is provided
    for k in {1..75}; do
      echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$k -w $warp -o $out/masks/$hemi/$k --interp=nn" >> $out/create_masks_cmds
    done
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/cortex -w $warp -o $out/masks/cortex --interp=nn" >> $out/create_masks_cmds
  fi
done

# SCPCT-related ROIs
if [[ "$str" == "vim" ]]; then

  echo "echo Create SCPCT-related ROIs..." > $out/create_masks_scpct_cmds
  ### if brain mask not provided, use standard
  if [ -z "$brainmask" ]; then
    #echo "echo brainmask not provided. use standard brain mask MNI152_T1_1mm_brain_mask instead..." >> $out/create_masks_scpct_cmds
    echo "$FSLDIR/bin/applywarp -r $ref -i $FSLDIR/data/standard/MNI152_T1_1mm_brain_mask -w $warp -o $out/masks/brain_mask --interp=nn" >> $out/create_masks_scpct_cmds
    brainmask="$out/masks/brain_mask"
  fi


  for hemi in left right; do
    ### SCPCT
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/SCPCT -w $warp -o $out/masks/$hemi/SCPCT" >> $out/create_masks_scpct_cmds
    echo "$FSLDIR/bin/fslmaths $out/masks/$hemi/SCPCT -thr 0.0001 -bin $out/masks/$hemi/SCPCT_bin" >> $out/create_masks_scpct_cmds
    ### if brain mask not provided, use standard
    #if [ -z "$brainmask" ]; then
      #echo "$FSLDIR/bin/fslmaths $out/brain_mask -rem $out/$hemi/SCPCT_bin -bin -rem $out/$hemi/tha -bin $out/$hemi/stop_for_scpct" >> $out/create_masks_scpct_cmds
    #else
    echo "$FSLDIR/bin/fslmaths $brainmask -rem $out/masks/$hemi/SCPCT_bin -bin -rem $out/masks/$hemi/tha -bin $out/masks/$hemi/stop_for_scpct" >> $out/create_masks_scpct_cmds
    #fi
  done
fi

queue=`fsl_sub --has_queues`
if [[ "$queue" == "Yes" ]]; then
  jobid=`fsl_sub -N create_masks -n -l $out/logs -t "$out/create_masks_cmds"`
  if [[ "$str" == vim ]]; then
    fsl_sub -N create_masks_scpct -n -l $out/logs -j $jobid "bash $out/create_masks_scpct_cmds"
  fi
else
  bash "$out/create_masks_cmds"
  bash "$out/create_masks_scpct_cmds"
fi
