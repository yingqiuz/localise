#!/bin/bash

#   Copyright (C) 2019 University of Oxford
#
#   SHCOPYRIGHT

# Written by Ying-Qiu Zheng

Usage() {
    cat << EOF

Usage:
    create_masks -ref <path> -warp <path> -out <folder> -aparc <path> -str <str_name> [options]

    Compulsory arguments:
       -ref <path>                      Path to reference image, i.e., the space you want to run localise in
       -warp <path>                     Path to warp field mapping the MNI standard space to the reference space
       -out <folder>                    Path to output folder
       -aparc <path>                    Path to cortical segmentation file generated by Freesurfer (must be in the reference space)
       -str <strcture_name>             Name of structure, e.g., vim, lgn, etc.

    Optional arguments:
       -brainmask <path>                Path to binary brain mask in the reference space

Description:
    Creates anatomical masks in reference space (-ref) for tractography and stores them under the output folder.

Example usage:
    create_masks -ref subj001/t1.nii.gz -out subj001 -aparc subj001/aparc.a2009s+aseg.nii.gz -warp subj001/std2str_warp.nii.gz -str vim
This will create necessary masks for localising vim in the reference space (t1.nii.gz).

EOF
    exit 1
}

[ -z "$1" ] && Usage

if [ -z "$FSLDIR" ]; then
  echo "Environment variable $FSLDIR does not exist. Please set up FSLDIR. "
  exit 1
fi

# Get the resources path using the Python function
RESOURCES_DIR=$(python -c "from localise.utils import get_resources_path; print(get_resources_path())")

# Check if the resources directory exists
if [ ! -d "$RESOURCES_DIR" ]; then
    echo "Error: Resources directory not found at $RESOURCES_DIR"
    exit 1
fi

### make file path absolute
get_abs_file_path() {
    file_path=$1

    # Check if realpath is available
    if command -v realpath > /dev/null 2>&1; then
        abs_path=$(realpath "$file_path")
    # Fallback to readlink -f if realpath is not available
    elif command -v readlink > /dev/null 2>&1; then
        abs_path=$(readlink -f "$file_path")
    else
        echo "Error: realpath and readlink commands are not available."
        exit 1
    fi

    echo "$abs_path"
}

# set default options
ref=""
warp=""
aparc=""
out=""
brainmask=""
str=""

### parse arguments
while [ -n "$1" ]; do
  case "$1" in
    -help)
      Usage
      ;;
    -ref)
      ref="$2"
      shift
      ;;
    -out)
      out="$2"
      shift
      ;;
    -warp)
      warp="$2"
      shift
      ;;
    -aparc)
      aparc="$2"
      shift
      ;;
    -brainmask)
      brainmask="$2"
      shift
      ;;
    -str)
      str="$2"
      shift
      ;;
    *)
      echo "Error: Invalid argument: $1"
      exit 1
    ;;
  esac
  shift
done

### Check if required arguments are provided
for arg in ref warp aparc out str; do
  if [ -z "${!arg}" ]; then
    echo "Error: Missing required argument -$arg." >&2
    Usage
    exit 1
  fi
done

### Validate file existence
for file in ref warp aparc; do
  if [ ! -f "${!file}" ]; then
    echo "Error: ${!file} does not exist." >&2
    exit 1
  fi
done

### Get absolute path for ref (assuming get_abs_file_path function exists)
refpath=$(get_abs_file_path "$ref")

### create output directory
mkdir -p "$out/masks/left" "$out/masks/right" "$out/commands_for_${str}"

echo "Creating masks for localising $str in $ref space..."
output_cmds_fname="$out/commands_for_${str}/create_masks_cmds"

### create masks
if [ ! -z "$aparc" ]; then
  aparc_basename=$(basename "$aparc")
  if [[ "$aparc" == *.mgz ]]; then  # TODO: maybe remove this
    if [ -z "$FREESURFER_HOME" ]; then
      echo "If you feed in the aparc.a2009s+aseg in *.mgz format, please set up FREESURFER_HOME. "
      exit 1
    fi
    $FREESURFER_HOME/bin/mri_convert $aparc $out/masks/${aparc_basename%.*}.nii.gz
    $FSLDIR/bin/flirt -in $out/masks/${aparc_basename%.*}.nii.gz -ref $ref -out $out/masks/${aparc_basename%.*}.nii.gz -applyxfm -usesqform -interp nearestneighbour
    aparc="$out/masks/${aparc_basename%.*}.nii.gz"
  elif [[ "$aparc" == *.nii ]] || [[ "$aparc" == *.nii.gz ]]; then
    $FSLDIR/bin/flirt -in $aparc -ref $ref -out $out/masks/${aparc_basename} -applyxfm -usesqform -interp nearestneighbour 
    aparc="$out/masks/${aparc_basename}"
  else
    echo "Invalid aparc.a2009s+aseg file. Please use *.mgz or *.nii.gz/*.nii file."
    exit 1
  fi
  #### cerebellum
  echo "$FSLDIR/bin/fslmaths $aparc -thr 6 -uthr 8 -bin $out/masks/left/cerebellum" > "$output_cmds_fname"
  echo "$FSLDIR/bin/fslmaths $aparc -thr 45 -uthr 47 -bin $out/masks/right/cerebellum" >> "$output_cmds_fname"
  echo "$FSLDIR/bin/fslmaths $aparc -thr 7 -uthr 7 -bin $out/masks/right/cerebellum_target" >> "$output_cmds_fname"
  echo "$FSLDIR/bin/fslmaths $aparc -thr 46 -uthr 46 -bin $out/masks/left/cerebellum_target" >> "$output_cmds_fname"
  echo "$FSLDIR/bin/fslmaths $aparc -thr 24 -uthr 24 -bin $out/masks/csf" >> "$output_cmds_fname"

  ### left hemisphere cortical masks (from 11101 to 11175)
  for k in {11101..11175}; do
    kk=$((k - 11100))
    echo "$FSLDIR/bin/fslmaths $aparc -thr $k -uthr $k -bin $out/masks/left/$kk" >> "$output_cmds_fname"
  done
  #echo "$FSLDIR/bin/fslmaths $aparc -thr 11100 -uthr 12175 -bin $out/cortex" >> $out/create_masks_cmds
  ### right hemisphere cortical masks (from 12101 to 12175)
  for k in {12101..12175}; do
    kk=$((k - 12100))
    echo "$FSLDIR/bin/fslmaths $aparc -thr $k -uthr $k -bin $out/masks/right/$kk" >> "$output_cmds_fname"
  done
  echo "$FSLDIR/bin/fslmaths $aparc -thr 11100 -uthr 12175 -bin $out/masks/cortex" >> "$output_cmds_fname"
fi

### warp standard masks into ref space
for hemi in left right; do
  ### create white matter masks - SCPCT tract
  for tract in scpct_mask{1..15}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> "$output_cmds_fname"
  done
  ### STR
  for tract in str_mask{1..10}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> "$output_cmds_fname"
  done
  ### ATR
  for tract in atr_mask{1..8}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> "$output_cmds_fname"
  done
  ### AR
  for tract in ar_mask{1..8}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> "$output_cmds_fname"
  done
  ### OR
  for tract in or_mask{1..10}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> "$output_cmds_fname"
  done
  ### fornix
  for tract in fx_mask{1..10}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> "$output_cmds_fname"
  done
  ### M1
  for tract in to_precentral_mask{1..12}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> "$output_cmds_fname"
  done
  ### S1
  for tract in to_postcentral_mask{1..12}; do
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$tract -w $warp -o $out/masks/$hemi/$tract --interp=nn" >> "$output_cmds_fname"
  done

  ### TODO: more masks to be added

  ### warps seeds into ref space
  case "$str" in
    vim)
      ### thalamus - although it's recommend to use FSL's MIST
      echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/tha -w $warp -o $out/masks/$hemi/seed --interp=nn" >> "$output_cmds_fname"
      echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/vim -w $warp -o $out/masks/$hemi/vim" >> "$output_cmds_fname"
      ;;
    lgn)
      echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/lgn -w $warp -o $out/masks/$hemi/lgn" >> "$output_cmds_fname"
      echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/lgn_bin -w $warp -o $out/masks/$hemi/seed  --interp=nn" >> "$output_cmds_fname"
      ;;
    *)
      echo "$str currently not supported. "
      exit 1
      ;;
  esac

  echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/exclusion -w $warp -o $out/masks/$hemi/exclusion --interp=nn" >> "$output_cmds_fname"

  # if [ -z "$aparc" ]; then   ### To be removed? maybe not?
  #   ### cerebellum - although it's recommend to use freesurfer's segmentation
  #   ##### MNI_roi/$hemi/cerebellum_target is the contralateral cerebellar target
  #   echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/cerebellum_target -w $warp -o $out/masks/$hemi/cerebellum_target --interp=nn" >> $out/create_masks_cmds
  #   ##### MNI_roi/$hemi/cerebellum is ipsilateral cerebellum to avoid
  #   echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/cerebellum -w $warp -o $out/masks/$hemi/cerebellum --interp=nn" >> $out/create_masks_cmds
  #   ### cortical parcels - if no aparc.a2009s+aseg file is provided
  #   for k in {1..75}; do
  #     echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/$k -w $warp -o $out/masks/$hemi/$k --interp=nn" >> $out/create_masks_cmds
  #   done
  #   echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/cortex -w $warp -o $out/masks/cortex --interp=nn" >> $out/create_masks_cmds
  # fi
done

# SCPCT-related ROIs
if [[ "$str" == "vim" ]]; then

  echo "echo Create SCPCT-related ROIs..." > "$out/commands_for_${str}/create_masks_scpct_cmds"
  ### if brain mask not provided, use standard
  if [ -z "$brainmask" ]; then
    #echo "echo brainmask not provided. use standard brain mask MNI152_T1_1mm_brain_mask instead..." >> $out/create_masks_scpct_cmds
    echo "$FSLDIR/bin/applywarp -r $ref -i $FSLDIR/data/standard/MNI152_T1_1mm_brain_mask -w $warp -o $out/masks/brain_mask --interp=nn" >> "$out/commands_for_${str}/create_masks_scpct_cmds"
    brainmask="$out/masks/brain_mask"
  fi


  for hemi in left right; do
    ### SCPCT
    echo "$FSLDIR/bin/applywarp -r $ref -i $RESOURCES_DIR/MNI_roi/$hemi/SCPCT -w $warp -o $out/masks/$hemi/SCPCT" >> "$out/commands_for_${str}/create_masks_scpct_cmds"
    echo "$FSLDIR/bin/fslmaths $out/masks/$hemi/SCPCT -thr 0.0001 -bin $out/masks/$hemi/SCPCT_bin" >> "$out/commands_for_${str}/create_masks_scpct_cmds"
    ### if brain mask not provided, use standard
    #if [ -z "$brainmask" ]; then
      #echo "$FSLDIR/bin/fslmaths $out/brain_mask -rem $out/$hemi/SCPCT_bin -bin -rem $out/$hemi/tha -bin $out/$hemi/stop_for_scpct" >> $out/create_masks_scpct_cmds
    #else
    echo "$FSLDIR/bin/fslmaths $brainmask -rem $out/masks/$hemi/SCPCT_bin -bin -rem $out/masks/$hemi/tha -bin $out/masks/$hemi/stop_for_scpct" >> "$out/commands_for_${str}/create_masks_scpct_cmds"
    #fi
  done
fi

queue=`fsl_sub --has_queues`
if [[ "$queue" == "Yes" ]]; then
  jobid=`fsl_sub -N create_masks -n -l $out/logs -t "$out/commands_for_${str}/create_masks_cmds"`
  if [[ "$str" == vim ]]; then
    fsl_sub -N create_masks_scpct -n -l $out/logs -j $jobid "bash $out/commands_for_${str}/create_masks_scpct_cmds"
  fi
else
  bash "$out/commands_for_${str}/create_masks_cmds"
  bash "$out/commands_for_${str}/create_masks_scpct_cmds"
fi
